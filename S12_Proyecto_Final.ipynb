   "source": [
    "# Detectando outliers\n",
    "def detectar_outliers(df, columna):\n",
    "    Q1 = df[columna].quantile(0.25)\n",
    "    Q3 = df[columna].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "    limite_inferior = Q1 - 1.5 * IQR\n",
    "    limite_superior = Q3 + 1.5 * IQR\n",
    "    outliers = df[(df[columna] < limite_inferior) | (df[columna] > limite_superior)]\n",
    "    return outliers\n",
    "\n",
    "outliers_monto = detectar_outliers(orders, 'monto_total')\n",
    "outliers_cantidad = detectar_outliers(orders, 'cantidad')\n",
    "\n",
    "print(f\"Outliers en monto_total: {len(outliers_monto)}\")\n",
    "print(f\"Outliers en cantidad: {len(outliers_cantidad)}\")"
   ]

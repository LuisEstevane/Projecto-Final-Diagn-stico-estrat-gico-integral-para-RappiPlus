    "# Cantidad de usuarios atipicos que agregaron algo al carro sin seleccionar un item\n",
    "\n",
    "query_usuarios_atipicos = '''\n",
    "WITH usuarios_select AS (\n",
    "    SELECT DISTINCT id_usuario\n",
    "    FROM events\n",
    "    WHERE nombre_evento = 'select_item'\n",
    "),\n",
    "usuarios_cart AS (\n",
    "    SELECT DISTINCT id_usuario\n",
    "    FROM events\n",
    "    WHERE nombre_evento = 'add_to_cart'\n",
    ")\n",
    "SELECT \n",
    "    COUNT(*) AS total_cart,\n",
    "    COUNT(*) FILTER (WHERE id_usuario NOT IN (SELECT id_usuario FROM usuarios_select)) AS cart_sin_select\n",
    "FROM usuarios_cart;\n",
    "'''\n",
    "usuarios_atipicos = pd.read_sql(query_usuarios_atipicos, con=engine)\n",
    "usuarios_atipicos"
   ]

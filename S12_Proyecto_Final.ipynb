    "axes[0,0].set_title('KPIs Financieros Globales')\n",
    "for i, v in enumerate([revenue, cost, marketing_investment, profit]):\n",
    "    axes[0,0].text(i, v + (v*0.02), f\"${v:,.0f}\", ha='center', fontsize=10, fontweight='bold', color='black')\n",
    "\n",
    "# Rentabilidad por país\n",
    "axes[0,1].bar(rentabilidad_pais['pais'], rentabilidad_pais['rentabilidad_neta'], \n",
    "              color=['#4CAF50','#2196F3','#FFC107'])\n",
    "axes[0,1].set_title('Rentabilidad neta por país')\n",
    "promedio_rentabilidad = rentabilidad_pais['rentabilidad_neta'].mean()\n",
    "axes[0,1].axhline(promedio_rentabilidad, color='gray', linestyle='--')\n",
    "axes[0,1].text(2, promedio_rentabilidad - 60000, f\"Promedio: ${promedio_rentabilidad:,.0f}\", \n",
    "               ha='right', color='gray', fontsize=10)\n",
    "for i, v in enumerate(rentabilidad_pais['rentabilidad_neta']):\n",
    "    axes[0,1].text(i, v + 20000, f\"${v:,.0f}\", ha='center', fontsize=9, fontweight='bold')\n",
    "\n",
    "# ROI por canal\n",
    "axes[1,0].bar(roi_por_canal['canal'], roi_por_canal['ROI (%)'], \n",
    "              color=['#FF5722','#009688','#3F51B5','#9C27B0'])\n",
    "axes[1,0].set_title('ROI de marketing por canal')\n",
    "promedio_roi = roi_por_canal['ROI (%)'].mean()\n",
    "axes[1,0].axhline(promedio_roi, color='gray', linestyle='--')\n",
    "axes[1,0].text(1.5, promedio_roi + 10, f\"Promedio ROI: {promedio_roi:.1f}%\", \n",
    "               ha='center', color='gray', fontsize=10)\n",
    "for i, v in enumerate(roi_por_canal['ROI (%)']):\n",
    "    axes[1,0].text(i, v + 10, f\"{v:.1f}%\", ha='center', fontsize=9, fontweight='bold')\n",
    "\n",
    "# Comportamiento de ventas\n",
    "ax1 = axes[1,1]\n",
    "ax2 = ax1.twinx()\n",
    "\n",
    "x1 = 0\n",
    "x2 = 0.5\n",
    "\n",
    "ax1.bar(x1, ticket_promedio, color='#2196F3', width=0.4, label='Ticket promedio')\n",
    "ax2.bar(x2, cantidad_promedio, color='#FF9800', width=0.4, label='Cantidad promedio')\n",
    "\n",
    "ax1.set_ylabel('Ticket promedio ($)')\n",
    "ax2.set_ylabel('Cantidad promedio')\n",
    "ax1.set_title('KPIs de comportamiento de ventas (comparativo)')\n",
    "\n",
    "ax1.text(x1, ticket_promedio + 10, f\"${ticket_promedio:,.2f}\", ha='center', fontsize=9)\n",
    "ax2.text(x2, cantidad_promedio + 0.05, f\"{cantidad_promedio:.2f}\", ha='center', fontsize=9)\n",
    "\n",
    "ax1.set_xticks([x1, x2])\n",
    "ax1.set_xticklabels(['Ticket promedio', 'Cantidad promedio'])\n",
    "\n",
    "fig.suptitle('Dashboard de KPIs del Negocio - RappiPlus', fontsize=16, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"

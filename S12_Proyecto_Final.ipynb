  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "ec1ed282",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Costo total (usando nombre_producto como clave)\n",
    "orders_cost = orders_clean_df.merge(catalog_clean_df, on='nombre_producto', how='left')\n",
    "cost = (orders_cost['costo_unitario'] * orders_cost['cantidad']).sum()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "3cc59750-ff9d-4151-a896-f26f1d77cb38",
   "metadata": {},

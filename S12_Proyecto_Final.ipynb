    "# Renombramos el DataFrame para claridad\n",
    "df = cohorte_final.copy()\n",
    "\n",
    "# Agregamos columna de semana para pivotar fácilmente\n",
    "df_long = pd.melt(df, id_vars=['cohorte'], value_vars=['retenido_w1', 'retenido_w2', 'retenido_w3'],\n",
    "                  var_name='semana', value_name='usuarios')\n",
    "\n",
    "# Convertimos la semana a número (1, 2, 3)\n",
    "df_long['semana'] = df_long['semana'].str.extract('(\\d)').astype(int)\n",
    "\n",
    "# Pivotamos para crear la matriz de retención\n",
    "retencion = df_long.pivot(index='cohorte', columns='semana', values='usuarios')\n",
    "\n",
    "# Normalizamos por el tamaño inicial de cada cohorte (semana 1)\n",
    "retencion_pct = retencion.div(retencion[1], axis=0) * 100\n",
    "retencion_pct.index = retencion_pct.index.strftime('%Y-%m')\n",
    "\n",
    "plt.figure(figsize=(10,6))\n",
    "sns.heatmap(retencion_pct, annot=True, fmt=\".1f\", cmap=\"Blues\")\n",
    "plt.title(\"Retención por Cohortes (%)\")\n",
    "plt.ylabel(\"Cohorte (mes de registro)\")\n",
    "plt.xlabel(\"Semana\")\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(10,6))\n",
    "for cohorte in retencion_pct.index:\n",
    "    plt.plot(retencion_pct.columns, retencion_pct.loc[cohorte], marker='o', label=str(cohorte))\n",
    "\n",
    "plt.title(\"Retención semanal por cohorte (%)\")\n",
    "plt.xlabel(\"Semana\")\n",
    "plt.ylabel(\"Retención (%)\")\n",
    "plt.legend(title=\"Cohorte\")\n",
    "plt.show()\n"
   ]

    "from statsmodels.stats.proportion import proportions_ztest\n",
    "\n",
    "# Contar conversiones y totales por grupo (variante)\n",
    "conversion_counts = experiment.groupby('variante')['convirtio'].sum()\n",
    "n_obs = experiment.groupby('variante')['convirtio'].count()\n",
    "\n",
    "# Test de proporciones\n",
    "stat, pval = proportions_ztest(count=conversion_counts, nobs=n_obs)\n",
    "print(f'Estadístico Z: {stat:.3f}')\n",
    "print(f'Valor p: {pval:.4f}')\n",
    "\n",
    "# Interpretación\n",
    "alpha = 0.05\n",
    "if pval < alpha:\n",
    "    print(\"✅ Rechazamos H₀: la nueva UI impacta significativamente la tasa de conversión.\")\n",
    "else:\n",
    "    print(\"❌ No se rechaza H₀: no hay evidencia estadística de impacto significativo.\")"
   ]
  },
